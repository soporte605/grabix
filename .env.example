# Copia este archivo a .env y ajusta los valores.
DB_NAME=grabix
DB_USER=grabix
DB_PASSWORD=grabix
DB_ROOT_PASSWORD=root
# true crea/actualiza las tablas solo. En producción ponlo en false y usa migraciones.
DB_SYNC=true
# Genera uno largo y aleatorio en producción (por ejemplo: openssl rand -base64 48)
JWT_SECRET=cambia-este-secreto
# URL pública con la que tus clientes abren los PDF que mandas por WhatsApp
PUBLIC_URL=http://localhost:8080
# demo = el plan se activa sin cobrar. Al conectar Stripe o Mercado Pago se cambia.
PAGOS_MODO=demo

# --- Correo (activación, recuperación de contraseña, invitaciones) ---
# Producción: crea una cuenta en resend.com, verifica tu dominio y pega la llave aquí.
RESEND_API_KEY=
MAIL_FROM=Grabix <no-responder@tudominio.com>
# Alternativa a Resend: cualquier SMTP. Gmail: smtp.gmail.com, 465, SMTP_SECURE=true y una "contraseña de aplicación".
# Sin cambiar nada, los correos llegan a Mailpit: http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Asistente con IA (Claude, de Anthropic) ---
# Crea una llave en console.anthropic.com > API Keys. Sin llave, el asistente aparece como "no configurado".
ANTHROPIC_API_KEY=
# Modelo. claude-opus-5-5 da las mejores respuestas; claude-haiku-5-5 es mucho más barato.
ASISTENTE_MODELO=claude-opus-5-5
# Preguntas por taller al día. Vacío = el límite de cada plan (40 / 150 / 500).
ASISTENTE_LIMITE_DIARIO=

WEB_PUERTO=8080
MAILPIT_PUERTO=8025
DB_PUERTO_LOCAL=3307
