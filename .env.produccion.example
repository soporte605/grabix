# Copia este archivo a .env.produccion en el servidor y llena los valores. Nunca lo subas a GitHub.
# Dominio sin "www" ni "app" (la landing queda en https://DOMINIO y el sistema en https://app.DOMINIO).
DOMINIO=grabix.com.mx
# Correo para avisos de los certificados HTTPS (Let's Encrypt).
CORREO_SSL=soporte@elikarsystems.com

# Base de datos: contraseñas largas y distintas (openssl rand -base64 24).
DB_NAME=grabix
DB_USER=grabix
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_SYNC=true

# Secreto de sesiones: openssl rand -base64 48
JWT_SECRET=

# demo = los planes se activan sin cobrar (hasta conectar Stripe o Mercado Pago).
PAGOS_MODO=demo

# Correo real: llave de resend.com con el dominio verificado.
RESEND_API_KEY=
MAIL_FROM=Grabix <no-responder@grabix.com.mx>

# Asistente con IA
ANTHROPIC_API_KEY=
ASISTENTE_MODELO=claude-opus-5-5
COTIZADOR_LIMITE=3
